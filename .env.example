# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
MY_PHONE_NUMBER=

# Public HTTPS/WSS URL
PUBLIC_BASE_URL=

# Groq speech-to-text, text-to-speech, and LLM
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3-turbo
TTS_MODEL=canopylabs/orpheus-v1-english
TTS_VOICE=troy
LLM_API_KEY=
LLM_MODEL=

# Scheduler
JARVIS_CALL_HOUR=7
JARVIS_CALL_MINUTE=0
TIMEZONE=Asia/Kathmandu

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CREDENTIALS_FILE=credentials/google_credentials.json
GOOGLE_TOKEN_FILE=credentials/token.json

# Database
TASK_DATABASE_URL=sqlite:///./jarvis.db
